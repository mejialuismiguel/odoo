<odoo>

    <record id="grades_course_tree" model="ir.ui.view">
        <field name="name">grades.course.tree</field>
        <field name="model">grades.course</field>
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="name"/>
                <field name="student_qty"/>
                <field name="grades_averages"/>
                <field name="description"/>
                <field name="is_active"/>
                <field name="teacher_id"/>
                <field name="course_start"/>
                <field name="course_end"/>
                <field name="last_evaluation"/>
                <field name="course_shift"/>
                <field name="evaluation_ids"/>
            </tree>
        </field>
    </record>

    <record id="grades_course_form" model="ir.ui.view">
        <field name="name">grades.course.form</field>
        <field name="model">grades.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <field name = "state" widget="statusbar"
                           statusbar_visible="register,in_progress,finished"
                           statusbar_colors='{"register":"blue", "in_progress":"green", "finished":"red"}'
                            options="{'clickable':1}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="description"/>
                            <field name="teacher_id" domain="[('is_teacher','=',True)]" required="1" readonly="state != 'register'"/>
                            <field name="course_start" required="1"/>
                            <field name="course_end" required="1"/>
                            <field name="evaluation_ids" readonly="state != 'register'"/>
                            <field name="student_ids" domain="[('is_student','=',True)]" widget="many2many_tags" required="1" readonly="state != 'register'"/>
                            <field name="create_uid" invisible="1"/>
                        </group>
                        <group>
                            <field name="course_image"/>
                            <field name="student_qty"/>
                            <field name="is_active"/>
                            <field name="last_evaluation" readonly="1"/>
                            <field name="course_shift"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="grades_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">grades.course</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>